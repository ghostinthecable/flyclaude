#!/usr/bin/env python3
"""Entry point. Re-execs into ./.venv if we were started with a Python that
can't see the dependencies, so `./bin/flyclaude` works without activating."""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

try:
    import numpy, scipy, pyarrow  # noqa: F401
except ImportError:
    venv = os.path.join(ROOT, ".venv")
    venv_py = os.path.join(venv, "bin", "python")
    # NB: compare sys.prefix, not the interpreter path -- a venv's `python` is
    # a symlink to the system one, so realpath() would say they're identical.
    if os.path.exists(venv_py) and os.path.normpath(sys.prefix) != os.path.normpath(venv):
        os.execv(venv_py, [venv_py, os.path.abspath(__file__)] + sys.argv[1:])
    sys.exit(
        "flyclaude: missing numpy/scipy/pyarrow and no usable .venv.\n"
        "          run ./setup.sh first."
    )

sys.path.insert(0, ROOT)
from flyclaude.cli import main

raise SystemExit(main())
